PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/parcelsetus
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ParcelSetus <no-reply@example.com>
# WhatsApp Cloud API. The template must be approved in WhatsApp Manager.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v27.0
WHATSAPP_SHIPMENT_BOOKED_TEMPLATE=shipment_booked
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_DEFAULT_COUNTRY_CODE=91
NOTIFICATION_CHANNELS=whatsapp
# Set in Vercel to authenticate the notification retry cron.
CRON_SECRET=
# Set true behind a single trusted reverse proxy in production.
TRUST_PROXY=false
